{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun dev",
      "type": "shell",
      "command": "bun dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
