---
import { m } from '@/paraglide/messages'
import { baseLocale, getLocale, type Locale, locales } from '@/paraglide/runtime'
import '@fontsource/noto-sans-sc/400.css'
import '@fontsource/noto-serif-sc/600.css'
import '../styles/site.css'
import { profileName, profileSameAs } from '@/data/site'
import { localizeCurrentHref } from '@/utils/localizeUrl'

interface Props {
  title: string
  bodyClass: string
}

const htmlLangs: Record<Locale, string> = {
  zh: 'zh-CN',
  en: 'en',
}

// og:locale 使用下划线格式，与 html lang 的连字符格式不同
const ogLocales: Record<Locale, string> = {
  zh: 'zh_CN',
  en: 'en',
}

// og:image 为 1200×630 分享图，en 页单独使用英文版
const ogImageHrefs: Record<Locale, string> = {
  zh: '/og-image.png',
  en: '/og-image-en.png',
}

const { title, bodyClass } = Astro.props
const locale = getLocale()
const site = Astro.site
const description = m.metaDescription()

// 与 trailingSlash: 'never' 对齐，canonical 指向无尾斜杠地址；
// build.format: 'file' 下静态路径带 .html 后缀（如 /en.html），需一并去掉
const canonicalPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/+$/, '') || '/'
const canonicalUrl = site ? new URL(canonicalPath, site).toString() : undefined
const ogImage = site ? new URL(ogImageHrefs[locale], site).toString() : ogImageHrefs[locale]

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: htmlLangs[locale],
      mainEntity: {
        '@type': 'Person',
        name: profileName,
        url: site?.toString(),
        jobTitle: m.profileRole(),
        description,
        sameAs: profileSameAs,
      },
    },
  ],
}
---

<!doctype html>
<html lang={htmlLangs[locale]} data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4efe4">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171512">
    <link rel="sitemap" href="/sitemap-index.xml">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    {site && canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {site &&
      locales.map((locale) => {
        return (
          <link
            rel="alternate"
            hreflang={htmlLangs[locale]}
            href={localizeCurrentHref(locale, Astro.url)}
          />
        )
      })}
    {site && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={localizeCurrentHref(baseLocale, Astro.url)}
      />
    )}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content={profileName}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={title}>
    <meta property="og:locale" content={ogLocales[locale]}>
    {locales
      .filter((other) => other !== locale)
      .map((other) => <meta property="og:locale:alternate" content={ogLocales[other]} />)}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
    <script src="../scripts/code-inspector" />
    <script is:inline>
    ;(() => {
      try {
        const stored = localStorage.getItem('wings-theme')
        document.documentElement.dataset.theme =
          stored === 'dark' || stored === 'light' ? stored : 'light'
      } catch {
        document.documentElement.dataset.theme = 'light'
      }
    })()
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{m.skipToContent()}</a>
    <slot />
    <div class="site-toast" data-toast role="status" aria-live="polite"></div>

    <script>
    import { m } from '@/paraglide/messages'

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Scroll reveal
    const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]')
    if (reduced) {
      revealItems.forEach((el) => {
        el.classList.add('is-visible')
      })
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              io.unobserve(entry.target)
            }
          })
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
      )
      revealItems.forEach((el) => {
        io.observe(el)
      })
    }

    // Copy email
    const toast = document.querySelector<HTMLElement>('[data-toast]')
    let toastTimer = 0
    const showToast = (message: string) => {
      if (!toast) return
      toast.textContent = message
      toast.classList.add('is-visible')
      window.clearTimeout(toastTimer)
      toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1800)
    }

    document.querySelectorAll<HTMLElement>('[data-copy-email]').forEach((el) => {
      el.addEventListener('click', async () => {
        const email = el.dataset.copyEmail || ''
        try {
          await navigator.clipboard.writeText(email)
          showToast(m.emailCopied())
        } catch {
          showToast(email)
        }
      })
    })

    // Theme toggle for the mobile header; the desktop bulb is a React island.
    const themeButtons = document.querySelectorAll<HTMLElement>('[data-theme-toggle]')
    themeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
        const apply = () => {
          document.documentElement.dataset.theme = next
          try {
            localStorage.setItem('wings-theme', next)
          } catch {
            /* ignore */
          }
        }

        if (!document.startViewTransition || reduced) {
          apply()
          return
        }

        const rect = button.getBoundingClientRect()
        const x = rect.left + rect.width / 2
        const y = rect.top + rect.height / 2
        const radius = Math.hypot(window.innerWidth, window.innerHeight)
        const transition = document.startViewTransition(apply)
        transition.ready.then(() => {
          document.documentElement.animate(
            {
              clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`],
            },
            {
              duration: 560,
              easing: 'cubic-bezier(.22,.61,.36,1)',
              pseudoElement: '::view-transition-new(root)',
            }
          )
        })
      })
    })
    </script>
  </body>
</html>

<style>
.skip-link {
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 999;
  padding: 10px 14px;
  border-radius: 4px;
  background: #111;
  color: #fff;
  font-size: 13px;
  text-decoration: none;
  transform: translateY(-160%);
}

.skip-link:focus {
  transform: translateY(0);
}

.site-toast {
  position: fixed;
  left: 50%;
  bottom: 76px;
  z-index: 210;
  transform: translate(-50%, 12px);
  padding: 9px 14px;
  border-radius: 4px;
  background: #111;
  color: #fff;
  font-size: 12px;
  opacity: 0;
  pointer-events: none;
  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

.site-toast.is-visible {
  opacity: 1;
  transform: translate(-50%, 0);
}

@media (max-width: 900px) {
  body {
    padding-bottom: 78px;
  }

  .site-toast {
    bottom: 108px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .site-toast {
    transition: none;
  }
}
</style>
