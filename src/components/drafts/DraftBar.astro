---
interface Props {
  active: 'paper' | 'blueprint' | 'index'
}

const { active } = Astro.props
---

<div class="draft-bar" aria-label="视觉草稿切换">
  <a class="draft-bar-home" href="/" aria-label="回到草稿选择">
    <span class="draft-dot"></span>
    <span>DRAFT</span>
  </a>
  <span class="draft-sep" aria-hidden="true"></span>
  <a
    class:list={['draft-link', { 'is-active': active === 'paper' }]}
    href="/drafts/paper/">纸上飞行</a
  >
  <a
    class:list={['draft-link', { 'is-active': active === 'blueprint' }]}
    href="/drafts/blueprint/">蓝图</a
  >
  <span class="draft-sep" aria-hidden="true"></span>
  <span class="draft-note">示例数据</span>
</div>
