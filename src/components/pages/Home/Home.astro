---
import Footer from '@/components/Footer/Footer.astro'
import Header from '@/components/Header/Header.astro'
import ThemeBookmark from '@/components/ThemeBookmark/ThemeBookmark'
import Layout from '@/layouts/Layout.astro'
import { m } from '@/paraglide/messages'
import About from './About.astro'
import Contact from './Contact.astro'
import Hero from './Hero.astro'
import Work from './Work.astro'
import Writing from './Writing.astro'

const nav = [
  { label: m.navHome(), href: '#home', key: 'home' },
  { label: m.navWork(), href: '#work', key: 'work' },
  { label: m.navAbout(), href: '#about', key: 'about' },
  { label: m.navWriting(), href: '#writing', key: 'writing' },
]
---

<Layout title={m.metaTitle()} bodyClass="paper-body">
  <div class="p-root">
    <div class="p-grain" aria-hidden="true"></div>

    <Header />

    <aside class="p-rail" aria-label={m.a11yRailNav()}>
      <nav class="p-rail-tabs">
        {nav.map((item, index) => (
          <a
            class:list={['p-tab', { 'is-active': index === 0 }]}
            href={item.href}
            data-nav-link={item.key}
            aria-current={index === 0 ? 'page' : undefined}
          >
            <span class="p-tab-label">{item.label}</span>
            <span class="p-tab-arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))}
      </nav>
      <ThemeBookmark client:idle />
    </aside>

    <nav class="p-mobilebar" aria-label={m.a11yMobileNav()}>
      {nav.map((item, index) => (
        <a
          class:list={['p-mobile-tab', { 'is-active': index === 0 }]}
          href={item.href}
          data-nav-link={item.key}
          aria-current={index === 0 ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <button
        class="p-mobile-theme"
        type="button"
        data-theme-toggle
        aria-label={m.a11yToggleDarkMode()}
      >
        ◐
      </button>
    </nav>

    <div class="above">
      <svg
        class="p-sketch"
        viewBox="0 0 1440 900"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <defs>
          <filter id="pencil-rough" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.012"
              numOctaves="2"
              seed="11"
              result="noise"
            />
            <feDisplacementMap
              in="SourceGraphic"
              in2="noise"
              scale="1.8"
              xChannelSelector="R"
              yChannelSelector="G"
            />
          </filter>
        </defs>

        <g class="p-sketch-lines" filter="url(#pencil-rough)">
          <path
            class="sk sk-muted"
            d="M 742 430 C 752 258 916 158 1092 174 C 1278 192 1392 318 1362 500 C 1334 668 1176 736 1014 712 C 852 688 744 590 752 438 C 757 360 782 302 820 256"
          />
          <path class="sk sk-orange" d="M 1248 118 L 1362 166 L 1296 232 Z" />
          <path class="sk sk-orange sk-dash" d="M 1248 118 L 1296 232 M 1362 166 L 1296 232" />

          <path class="sk sk-blue" d="M 632 676 C 686 666 728 636 762 600" />
          <path class="sk sk-blue" d="M 750 604 L 762 600 L 758 613" />

          <path
            class="sk sk-muted"
            d="M 126 420 L 136 398 M 126 420 L 136 442 M 126 420 L 104 410 M 126 420 L 104 432"
          />
          <path
            class="sk sk-muted"
            d="M 1120 708 L 1140 680 M 1134 714 L 1154 686 M 1148 720 L 1168 692 M 1162 726 L 1182 698"
          />
          <path class="sk sk-muted" d="M 90 812 L 110 812 M 100 802 L 100 822" />
          <path class="sk sk-muted" d="M 1330 84 L 1348 84 M 1339 75 L 1339 93" />
          <circle class="sk sk-muted" cx="1310" cy="770" r="2.5" />
          <circle class="sk sk-muted" cx="700" cy="190" r="2" />
          <circle class="sk sk-muted" cx="1390" cy="610" r="1.8" />
          <path class="sk sk-muted sk-dash" d="M 60 300 C 90 286 120 292 138 312" />
        </g>

        <g class="p-sketch-labels">
          <text x="1240" y="842">NOTE / 01</text>
        </g>
      </svg>
    </div>

    <main id="main" class="p-main">
      <Hero />
      <Work />
      <div class="p-fold" aria-hidden="true">
        <span>FOLD HERE</span>
      </div>
      <About />
      <Writing />
      <Contact />
    </main>

    <Footer />
  </div>

  <script>
  // 滚动到哪个 section，就高亮 rail / mobilebar 里的同名导航项
  const navLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-link]'))
  const sections = ['home', 'work', 'about', 'writing']
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el))

  const setActive = (key: string) => {
    navLinks.forEach((link) => {
      const active = link.dataset.navLink === key
      link.classList.toggle('is-active', active)
      if (active) link.setAttribute('aria-current', 'page')
      else link.removeAttribute('aria-current')
    })
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
        if (visible?.target.id) setActive(visible.target.id)
      },
      { rootMargin: '-24% 0px -58% 0px', threshold: [0.01, 0.2, 0.5] }
    )
    sections.forEach((section) => {
      observer.observe(section)
    })
  }
  </script>
</Layout>

<style>
.p-root {
  position: relative;
  overflow: clip;
  min-height: 100vh;
}

.p-grain {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.55;
  background-image: radial-gradient(rgba(29, 27, 23, 0.14) 0.55px, transparent 0.55px);
  background-size: 4px 4px;
  mask-image: linear-gradient(to bottom, black, transparent 80%);
}

:global(html[data-theme="dark"]) .p-grain {
  opacity: 0.3;
  background-image: radial-gradient(rgba(242, 237, 227, 0.14) 0.55px, transparent 0.55px);
}

.above {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 0;
  width: 100vw;
  max-width: none;
  height: 100vh;
  opacity: 0.72;
  pointer-events: none;
}

.above::before {
  position: absolute;
  inset: -30px 0 20px;
  z-index: 0;
  background-image:
    linear-gradient(var(--p-rule) 1px, transparent 1px),
    linear-gradient(90deg, var(--p-rule) 1px, transparent 1px);
  background-size: 32px 32px;
  content: "";
  mask-image: radial-gradient(ellipse at 58% 44%, black 4%, transparent 74%);
  opacity: 0.32;
  pointer-events: none;
}

.p-main {
  position: relative;
  z-index: 1;
  width: min(100% - 48px, 1280px);
  margin: 0 auto;
  padding-left: 80px;
}

.p-rail {
  position: fixed;
  top: 50%;
  left: 16px;
  z-index: 60;
  display: flex;
  width: 76px;
  flex-direction: column;
  align-items: center;
  gap: 0;
  transform: translateY(-50%);
}

.p-rail-tabs {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 8px;
}

.p-tab {
  --tab: var(--p-blue);
  --tab-ink: #fff;
  position: relative;
  display: flex;
  width: 72px;
  height: 50px;
  align-items: center;
  gap: 5px;
  padding: 0 10px 9px;
  border: 0;
  border-left: 5px solid var(--tab);
  border-radius: 0 5px 5px 0;
  background: var(--p-sheet);
  box-shadow: 3px 3px 0 var(--p-rule);
  clip-path: polygon(0 0, 100% 0, 100% calc(100% - 9px), 50% 100%, 0 calc(100% - 9px));
  color: var(--p-ink);
  font-family: var(--p-sans);
  font-size: 13px;
  text-decoration: none;
  transition:
    transform 0.2s ease,
    background-color 0.2s ease,
    color 0.2s ease,
    box-shadow 0.2s ease;
}

.p-tab:nth-child(1) {
  --tab: var(--p-blue);
}

.p-tab:nth-child(2) {
  --tab: var(--p-green);
}

.p-tab:nth-child(3) {
  --tab: var(--p-orange);
}

.p-tab:nth-child(4) {
  --tab: var(--p-red);
}

.p-tab:hover,
.p-tab:focus-visible {
  transform: translateX(4px);
}

.p-tab.is-active {
  width: 78px;
  height: 54px;
  background: var(--tab);
  box-shadow: 4px 4px 0 var(--p-rule);
  color: var(--tab-ink);
  transform: translateX(4px);
}

.p-tab-label {
  flex: 1;
  text-align: left;
}

.p-tab-arrow {
  opacity: 0;
  font-family: var(--p-mono);
  font-size: 11px;
  transform: translateX(-4px);
  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

.p-tab:hover .p-tab-arrow,
.p-tab:focus-visible .p-tab-arrow,
.p-tab.is-active .p-tab-arrow {
  opacity: 1;
  transform: translateX(0);
}

.p-mobilebar {
  display: none;
}

.p-fold {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 8px 0;
  color: var(--p-muted);
  font-family: var(--p-mono);
  font-size: 11px;
  letter-spacing: 0.16em;
}

.p-fold::before,
.p-fold::after {
  flex: 1;
  border-top: 1px dashed var(--p-rule);
  content: "";
}

.p-fold span {
  white-space: nowrap;
}

.p-sketch {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 0;
  width: 100vw;
  max-width: none;
  height: 100vh;
  opacity: 0.72;
  pointer-events: none;
}

.p-sketch-lines .sk {
  fill: none;
  stroke: var(--p-muted);
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.1;
  vector-effect: non-scaling-stroke;
}

.p-sketch .sk-blue {
  stroke: var(--p-blue);
}

.p-sketch .sk-orange {
  stroke: var(--p-orange);
}

.p-sketch .sk-dash {
  stroke-dasharray: 7 9;
}

.p-sketch .p-sketch-labels text {
  fill: var(--p-muted);
  font-family: var(--p-mono);
  font-size: 11.5px;
  letter-spacing: 0.08em;
  opacity: 0.62;
}

@media (max-width: 1080px) {
  .p-main {
    padding-left: 96px;
  }
}

@media (max-width: 900px) {
  .p-rail {
    display: none;
  }

  .p-mobilebar {
    --mobilebar-bottom: calc(8px + env(safe-area-inset-bottom));
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 90;
    display: flex;
    align-items: stretch;
    gap: 5px;
    padding: 8px 10px var(--mobilebar-bottom);
    border-top: 1px solid var(--p-rule);
    background: var(--p-sheet);
    box-shadow: 0 -4px 18px rgba(29, 27, 23, 0.08);
  }

  .p-mobile-tab {
    --tab: var(--p-blue);
    --tab-ink: #fff;
    position: relative;
    display: grid;
    flex: 1;
    min-height: 42px;
    place-items: center;
    border-radius: 5px 5px 0 0;
    color: var(--p-muted);
    font-family: var(--p-mono);
    font-size: 11.5px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .p-mobile-tab:nth-child(1) {
    --tab: var(--p-blue);
  }

  .p-mobile-tab:nth-child(2) {
    --tab: var(--p-green);
  }

  .p-mobile-tab:nth-child(3) {
    --tab: var(--p-orange);
  }

  .p-mobile-tab:nth-child(4) {
    --tab: var(--p-red);
  }

  .p-mobile-tab::after {
    position: absolute;
    right: 0;
    bottom: calc(-1 * var(--mobilebar-bottom));
    left: 0;
    height: var(--mobilebar-bottom);
    background: transparent;
    content: "";
    pointer-events: none;
    transition: background-color 0.2s ease;
  }

  .p-mobile-tab.is-active {
    background: var(--tab);
    color: var(--tab-ink);
  }

  .p-mobile-tab.is-active::after {
    background: var(--tab);
  }

  .p-mobile-theme {
    width: 38px;
    border: 1px solid var(--p-rule);
    border-radius: 5px;
    background: var(--p-paper);
    color: var(--p-ink);
    font-size: 15px;
  }

  .p-grain {
    opacity: 0.35;
  }

  .above::before {
    opacity: 0.18;
  }

  .p-sketch {
    display: none;
  }

  .p-main {
    width: calc(100% - 40px);
    padding-left: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .p-tab {
    transition: none;
  }
}
</style>
