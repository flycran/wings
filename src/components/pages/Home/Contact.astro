---
import { getSite } from '@/data/site'
import { m } from '@/paraglide/messages'
import Button from './Button.astro'
import Kicker from './Kicker.astro'

const site = getSite()

const resumeUrl = '/pdf/resume.pdf'
---

<section class="p-contact" id="contact">
  <Kicker data-reveal>04 / CONTACT</Kicker>
  <h2 data-reveal>
    {m.homeContactTitle1()}<br>
    {m.homeContactTitle2()}
  </h2>
  <a class="p-email" href={`mailto:${site.profile.email}`} data-reveal>{site.profile.email}</a>
  <div class="p-contact-actions" data-reveal>
    <Button variant="primary" type="button" data-copy-email={site.profile.email}>
      {m.actionCopyEmail()}
    </Button>
    <Button href="https://github.com/flycran" target="_blank" rel="noopener noreferrer">
      GitHub <span aria-hidden="true">↗</span>
    </Button>
    <Button
      href="https://juejin.cn/user/1737682330585838"
      target="_blank"
      rel="noopener noreferrer"
    >
      {m.actionJuejin()} <span aria-hidden="true">↗</span>
    </Button>
    <Button href={`${resumeUrl}?dl=1`} download="Flycran-Resume.pdf">
      {m.contactResumeLink()} <span aria-hidden="true">↓</span>
    </Button>
  </div>
</section>

<style>
.p-contact {
  position: relative;
  margin-top: 40px;
  padding: 104px 0 88px;
  border-top: 1px solid var(--p-rule);
}

.p-contact h2 {
  max-width: 900px;
  margin: 16px 0 30px;
  font-family: var(--p-serif);
  font-size: clamp(1.9rem, 3.2vw, 2.6rem);
  font-weight: 600;
  letter-spacing: 0.005em;
  line-height: 1.4;
}

.p-email {
  display: inline-block;
  padding-bottom: 4px;
  border-bottom: 2px solid var(--p-blue);
  color: var(--p-blue);
  font-family: var(--p-mono);
  font-size: clamp(1.15rem, 2.6vw, 1.9rem);
  text-decoration: none;
}

.p-email:hover {
  border-color: var(--p-ink);
  color: var(--p-ink);
}

.p-contact-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
}

@media (max-width: 900px) {
  .p-contact {
    padding: 76px 0 64px;
  }
}

@media (max-width: 540px) {
  .p-contact h2 {
    font-size: 1.9rem;
  }
}
</style>
