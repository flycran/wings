---
import type smartUnit from './demos/smart-unit.astro'

interface Props {
  id: string
}

const { id } = Astro.props

/* demos/ 目录约定：文件名 = 项目 id，有 demo 的项目放入同名文件即生效 */
const demos = import.meta.glob<{ default: typeof smartUnit }>('./demos/*.astro', { eager: true })
const entry = demos[`./demos/${id}.astro`]
if (!entry) {
  throw new Error(`No demo for project "${id}": expected src/components/ProjectDemo/demos/${id}.astro`)
}
const Demo = entry.default
---

<Demo />
