---
import type { ProjectDemo as ProjectDemoId } from '../../data/site'
import GravityDemo from './GravityDemo/GravityDemo'
import RtkEndpointsDemo from './RtkEndpointsDemo/RtkEndpointsDemo'
import SmartUnitDemo from './SmartUnitDemo/SmartUnitDemo'

interface Props {
  demo: ProjectDemoId
}

const { demo } = Astro.props
---

{demo === 'unit' && <SmartUnitDemo client:visible />}
{demo === 'gravity' && <GravityDemo client:visible />}
{demo === 'ide' && <RtkEndpointsDemo client:visible />}
