---
import type { WingsProject } from '../data/site'

interface Props {
  project: WingsProject
}

const { project } = Astro.props
---

<aside class="p-work-note" data-reveal>
  <span class="p-work-note-index">{project.index} / REFERENCE</span>
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  {
    project.href ? (
      <a class="p-work-note-link" href={project.href}>
        {project.linkLabel}
      </a>
    ) : (
      <span class="p-work-note-link">{project.linkLabel}</span>
    )
  }
</aside>
