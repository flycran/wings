---
import DraftLayout from '../../layouts/DraftLayout.astro'
import Crane from '../../components/drafts/Crane.astro'
import CodeTabs from '../../components/drafts/CodeTabs.astro'
import {
  profile,
  projects,
  capabilities,
  principles,
  now,
  platforms,
  writing,
  colophon,
} from '../../data/draft'
import '../../styles/blueprint.css'

const nav = [
  { label: 'HOME', no: '00', href: '#home', key: 'home' },
  { label: 'WORK', no: '01', href: '#work', key: 'work' },
  { label: 'PROFILE', no: '02', href: '#about', key: 'about' },
  { label: 'WRITING', no: '03', href: '#writing', key: 'writing' },
]
---

<DraftLayout title="Wings v2 · 蓝图草稿" bodyClass="blueprint-body" active="blueprint">
  <div class="b-root">
    <div class="b-grid-overlay" aria-hidden="true"></div>

    <header class="b-topbar">
      <div class="b-coord" aria-hidden="true">X 0.00&nbsp;&nbsp;Y 0.00</div>
      <a class="b-logo" href="#home" aria-label="FLYCRAN 首页">
        <span class="b-logo-mark" aria-hidden="true">◇</span>
        <span>FLYCRAN</span>
        <em>WINGS / 2026</em>
      </a>
      <div class="b-topbar-right">
        <span class="b-rev">REV. A</span>
        <a class="b-topbar-cta" href="#contact">RESUME ↓</a>
      </div>
    </header>

    <aside class="b-rail" aria-label="索引导航">
      <div class="b-rail-rule" aria-hidden="true"></div>
      <nav class="b-rail-tabs">
        {
          nav.map((item, index) => (
            <a
              class:list={['b-tab', { 'is-active': index === 0 }]}
              href={item.href}
              data-nav-link={item.key}
              aria-current={index === 0 ? 'page' : undefined}
            >
              <span class="b-tab-no">{item.no}</span>
              <span class="b-tab-label">{item.label}</span>
            </a>
          ))
        }
      </nav>
      <span class="b-rail-meta">SHEET 01<br />SCALE 1:1</span>
    </aside>

    <nav class="b-mobilebar" aria-label="移动端导航">
      {
        nav.map((item, index) => (
          <a
            class:list={['b-mobile-tab', { 'is-active': index === 0 }]}
            href={item.href}
            data-nav-link={item.key}
            aria-current={index === 0 ? 'page' : undefined}
          >
            <span>{item.no}</span>{item.label}
          </a>
        ))
      }
    </nav>

    <main id="main" class="b-main">
      <section class="b-hero" id="home">
        <div class="b-hero-copy">
          <div class="b-status">
            <span class="b-status-box" aria-hidden="true"></span>
            <span>STATUS: OPEN TO WORK</span>
            <span class="b-status-sep">/</span>
            <span>{profile.location}</span>
          </div>
          <p class="b-kicker">SPEC 001 — FRONTEND ARCHITECT / DX &amp; INFRA</p>
          <h1>
            <span>BUILD TOOLS.</span>
            <span class="b-outline">SHIP</span>
            <span class="b-outline">EXPERIENCES.</span>
          </h1>
          <p class="b-cn-headline">把重复劳动变成工具，把复杂系统变成体验。</p>
          <p class="b-intro">{profile.intro}</p>
          <div class="b-actions">
            <a class="b-btn b-btn--primary" href="#work">VIEW WORK <span aria-hidden="true">↘</span></a>
            <a class="b-btn" href="#contact">RESUME <span aria-hidden="true">↓</span></a>
            <button class="b-copy" type="button" data-copy-email={profile.email}>COPY EMAIL</button>
          </div>
          <div class="b-hero-links">
            {
              profile.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label.toUpperCase()} <span aria-hidden="true">↗</span>
                </a>
              ))
            }
            <span class="b-hero-links-note">SAMPLE DATA / REPLACE LATER</span>
          </div>
        </div>

        <div class="b-hero-stage">
          <div class="b-drawing">
            <div class="b-reticle" aria-hidden="true"></div>
            <div class="b-crosshair b-crosshair--x" aria-hidden="true"></div>
            <div class="b-crosshair b-crosshair--y" aria-hidden="true"></div>
            <div class="b-dim-top" aria-hidden="true"><span>348.57</span></div>
            <div class="b-dim-left" aria-hidden="true"><span>294.00</span></div>
            <Crane variant="blueprint" class="b-crane" label="蓝图纸鹤，点一下扇动翅膀" />
            <div class="b-scan" aria-hidden="true"></div>
            <span class="b-drawing-label">FIG. 01 — ORIGAMI CRANE / FOLD ANGLE 120°</span>
            <span class="b-angle-label" aria-hidden="true">FOLD 120°</span>
          </div>

          <div class="b-spec-card">
            <div class="b-spec-head">
              <span>SPEC / PROFILE.TS</span>
              <span>COMPILED</span>
            </div>
            <CodeTabs variant="blueprint" />
            <div class="b-spec-foot">
              <span>NO DATABASE</span>
              <span>STATIC / ASTRO</span>
            </div>
          </div>
        </div>
      </section>

      <section class="b-section" id="work">
        <div class="b-section-head">
          <span class="b-section-index">01 / WORK</span>
          <div>
            <p class="b-kicker">BUILD LOG / SELECTED OUTPUT</p>
            <h2>做过的工具</h2>
          </div>
          <p class="b-section-note">EACH ENTRY SHIPS WITH A LIVE PROOF.<br />NOT A SCREENSHOT.</p>
        </div>

        <div class="b-work-grid">
          <article
            class="b-sheet b-sheet--wide"
            style="--accent: var(--b-green); --accent-bright: var(--b-green);"
          >
            <div class="b-sheet-head">
              <span>{projects[0].index} / OPEN SOURCE</span>
              <span>ROLE: {projects[0].role}</span>
              <span>{projects[0].year}</span>
            </div>
            <div class="b-sheet-main">
              <div class="b-sheet-copy">
                <h3>{projects[0].title}</h3>
                <p class="b-sheet-sub">{projects[0].subtitle}</p>
                <p>{projects[0].summary}</p>
                <div class="b-metrics">
                  <span>12 UNITS</span><span>3 LOCALES</span><span>0 DEPS</span>
                </div>
                <a class="b-link" href={projects[0].href} target="_blank" rel="noopener noreferrer">
                  OPEN REPOSITORY <span aria-hidden="true">↗</span>
                </a>
              </div>
              <div class="b-sheet-visual">
                <div class="b-demo b-demo--unit" data-unit-demo>
                  <div class="b-demo-head"><span>LIVE / smart-unit</span><span>SAMPLE</span></div>
                  <label for="b-unit-input">INPUT VALUE</label>
                  <input id="b-unit-input" data-unit-input value="1234567" inputmode="decimal" />
                  <div class="b-unit-output">
                    <span data-unit-output>1.23</span><span data-unit-suffix>M</span>
                  </div>
                  <div class="b-unit-meta">
                    <span>AUTO UNIT</span>
                    <div class="b-unit-locale">
                      <button class="is-active" type="button" data-locale="en">EN</button>
                      <button type="button" data-locale="zh">ZH</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </article>

          <article
            class="b-sheet"
            style="--accent: var(--b-cyan); --accent-bright: var(--b-cyan);"
          >
            <div class="b-sheet-head">
              <span>{projects[1].index} / CREATIVE</span>
              <span>{projects[1].year}</span>
            </div>
            <div class="b-sheet-copy">
              <h3>{projects[1].title}</h3>
              <p class="b-sheet-sub">{projects[1].subtitle}</p>
              <p>{projects[1].summary}</p>
            </div>
            <div class="b-demo b-demo--gravity" aria-label="贡献图物理动画示意">
              <div class="b-demo-head"><span>SIMULATION / RAPIER2D</span><span>SAMPLE</span></div>
              <div class="b-gravity-stage" aria-hidden="true">
                <div class="b-gravity-text">FLY</div>
                <div class="b-gravity-grid">
                  {
                    Array.from({ length: 112 }).map((_, index) => (
                      <span
                        class:list={[
                          'b-gravity-cell',
                          index % 17 < 3 ? 'is-falling' : '',
                          index % 11 === 0 ? 'is-bright' : '',
                        ]}
                        style={`--d:${(index % 13) * 55}ms`}
                      />
                    ))
                  }
                </div>
              </div>
            </div>
            <div class="b-sheet-foot">
              <div class="b-tags">
                {projects[1].stack.map((item) => <span>{item}</span>)}
              </div>
              <a class="b-link" href={projects[1].href} target="_blank" rel="noopener noreferrer">
                SOURCE <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>

          <article
            class="b-sheet"
            style="--accent: var(--b-orange); --accent-bright: var(--b-orange);"
          >
            <div class="b-sheet-head">
              <span>{projects[2].index} / DEVELOPER TOOL</span>
              <span>{projects[2].year}</span>
            </div>
            <div class="b-sheet-copy">
              <h3>{projects[2].title}</h3>
              <p class="b-sheet-sub">{projects[2].subtitle}</p>
              <p>{projects[2].summary}</p>
            </div>
            <div class="b-demo b-demo--ide">
              <div class="b-ide-top"><span>endpoints.ts</span><span>TS</span></div>
              <div class="b-ide-code" aria-hidden="true">
                <div><span class="b-ide-ln">12</span><span class="tk-key">export const</span> api = createApi(&#123;</div>
                <div><span class="b-ide-ln">13</span>  endpoints: (build) =&gt; (&#123;</div>
                <div><span class="b-ide-ln">14</span>    getUser: build.query&lt;User, string&gt;(&#123;</div>
                <div><span class="b-ide-ln">15</span>      query: (id) =&gt; <span class="tk-str">`/api/user/&#36;&#123;id&#125;`</span>,</div>
                <div><span class="b-ide-ln">16</span>    &#125;),</div>
                <div class="b-ide-highlight"><span class="b-ide-ln">20</span>  <span class="b-ide-hook">useGetUserQuery</span>(id)</div>
              </div>
              <div class="b-ide-tip">
                <span class="b-ide-method">GET</span>
                <span>/api/user/:id</span>
                <span class="b-ide-tip-note">GO TO DEFINITION</span>
              </div>
              <div class="b-ide-cursor" aria-hidden="true"></div>
            </div>
            <div class="b-sheet-foot">
              <div class="b-tags">
                {projects[2].stack.map((item) => <span>{item}</span>)}
              </div>
              <a class="b-link" href={projects[2].href} target="_blank" rel="noopener noreferrer">
                SOURCE <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>

          <aside class="b-reference">
            <span class="b-reference-no">REF / 004</span>
            <div>
              <h3>Wings / 本站</h3>
              <p>Astro 静态站、零数据库、纸感设计系统。这个页面本身也是案例。</p>
            </div>
            <span class="b-reference-link">CASE STUDY / SOON →</span>
          </aside>
        </div>
      </section>

      <section class="b-section" id="about">
        <div class="b-section-head">
          <span class="b-section-index">02 / PROFILE</span>
          <div>
            <p class="b-kicker">OPERATING MANUAL / HOW I WORK</p>
            <h2>关于我</h2>
          </div>
          <p class="b-section-note">NOT A RESUME SUMMARY.<br />WHY I BUILD TOOLS.</p>
        </div>

        <div class="b-about-grid">
          <figure class="b-profile-card">
            <div class="b-profile-head"><span>PROFILE / FLYCRAN</span><span>01</span></div>
            <div class="b-profile-inner">
              <span class="b-profile-cross" aria-hidden="true"></span>
              <span class="b-profile-char">飞</span>
              <span class="b-profile-coord" aria-hidden="true">X 128.0<br />Y 256.0</span>
              <span class="b-profile-note">PHOTO / ILLUSTRATION<br />TO BE REPLACED</span>
            </div>
            <figcaption>FIG. 02 — OPERATOR / 示例头像</figcaption>
          </figure>

          <div class="b-about-copy">
            <p class="b-lead">我从写页面开始，慢慢对“为什么每次都要手动做这件事”更感兴趣。</p>
            <p>
              现在我做前端架构和开发者工具：让类型、构建、编辑器替人记住规则，让团队把时间花在产品上。我喜欢把反复出现的问题，变成一次性的解决方案；也喜欢把复杂的东西画清楚、讲明白。
            </p>
            <p>
              我想找的团队：重视工程质量，也愿意为体验多走一步；有真实的用户和反馈；不把“能跑”当成终点。
            </p>

            <div class="b-list">
              <p class="b-kicker">PRINCIPLES / CHECKLIST</p>
              {
                principles.map((item) => (
                  <div class="b-check">
                    <span aria-hidden="true">[x]</span>
                    <p>{item}</p>
                  </div>
                ))
              }
            </div>

            <div class="b-now">
              <p class="b-kicker">NOW / CURRENT STATE</p>
              {
                now.map((item) => (
                  <div class="b-now-row">
                    <span>{item.label}</span>
                    <p>{item.value}</p>
                  </div>
                ))
              }
            </div>

            <div class="b-ask">
              <span>ASK ME ABOUT</span>
              <div><em>#TypeScript</em><em>#BuildTools</em><em>#DesignSystems</em><em>#IndieHacking</em></div>
            </div>
          </div>
        </div>
      </section>

      <section class="b-section" id="writing">
        <div class="b-section-head">
          <span class="b-section-index">03 / WRITING</span>
          <div>
            <p class="b-kicker">EXTERNAL REFERENCES / NO CMS</p>
            <h2>文章写在别处</h2>
          </div>
          <p class="b-section-note">INDEX ONLY.<br />READ AT THE SOURCE.</p>
        </div>

        <p class="b-writing-intro">
          长文主要发布在掘金。这个页面只保留平台入口和精选文章，不再维护站内文章系统。
        </p>

        <div class="b-platforms">
          {
            platforms.map((platform, index) => (
              <a
                class="b-platform"
                href={platform.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="b-platform-no">PLATFORM / 0{index + 1}</span>
                <div class="b-platform-main">
                  <strong>{platform.name}</strong>
                  <span>{platform.handle}</span>
                </div>
                <p>{platform.description}</p>
                <span class="b-platform-arrow" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>

        <div class="b-writing-table">
          <div class="b-writing-head">
            <span>REF</span><span>TITLE</span><span>PLATFORM</span><span>DATE</span><span>TAG</span><span />
          </div>
          {
            writing.map((item, index) => (
              <a class="b-writing-row" href="https://juejin.cn" target="_blank" rel="noopener noreferrer">
                <span class="b-writing-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="b-writing-title">{item.title}</span>
                <span>{item.platform}</span>
                <span>{item.date}</span>
                <span class="b-writing-tag">{item.tag}</span>
                <span class="b-writing-arrow" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
        <p class="b-writing-foot">SAMPLE LINKS / LAST SYNC 2026.10 / GITHUB ACTION READY</p>
      </section>

      <section class="b-contact" id="contact">
        <p class="b-kicker">04 / CONTACT</p>
        <h2>LET'S BUILD.</h2>
        <p class="b-contact-cn">如果你在找一个能把工具做好、也愿意把界面做有趣的人，聊聊。</p>
        <a class="b-email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="b-actions">
          <button class="b-btn b-btn--primary" type="button" data-copy-email={profile.email}>
            COPY EMAIL
          </button>
          <a class="b-btn" href="https://github.com/flycran" target="_blank" rel="noopener noreferrer">
            GITHUB ↗
          </a>
          <a class="b-btn" href="https://juejin.cn" target="_blank" rel="noopener noreferrer">
            JUEJIN ↗
          </a>
        </div>
        <p class="b-contact-note">SAMPLE EMAIL / REPLACE WITH REAL CONTACT</p>

        <div class="b-titleblock">
          <div><span>DRAWING NO.</span><strong>W-002</strong></div>
          <div><span>SCALE</span><strong>1:1</strong></div>
          <div><span>REV</span><strong>A</strong></div>
          <div><span>SHEET</span><strong>1 / 1</strong></div>
          <div><span>DRAWN BY</span><strong>FLYCRAN</strong></div>
          <div><span>DATE</span><strong>2026.10</strong></div>
        </div>
      </section>
    </main>

    <footer class="b-footer">
      <div class="b-footer-top">
        <span>WINGS / 飞鹤 / 自由</span>
        <span>{colophon.note}</span>
      </div>
      <div class="b-footer-wordmark" aria-label="FLYCRAN">FLYCRAN</div>
      <div class="b-footer-grid">
        <p>BUILT WITH {colophon.builtWith.toUpperCase()}<br />NO DATABASE. NO TRACKING.</p>
        <p>© {colophon.year} FLYCRAN<br />ALL MISTAKES ARE MINE.</p>
        <p><a href="#home">BACK TO TOP ↑</a><br /><a href="#work">VIEW WORK</a></p>
      </div>
    </footer>
  </div>

  <script>
    const navLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-link]'))
    const sections = ['home', 'work', 'about', 'writing']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el))

    const setActive = (key: string) => {
      navLinks.forEach((link) => {
        const active = link.dataset.navLink === key
        link.classList.toggle('is-active', active)
        if (active) link.setAttribute('aria-current', 'page')
        else link.removeAttribute('aria-current')
      })
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
          if (visible?.target.id) setActive(visible.target.id)
        },
        { rootMargin: '-24% 0px -58% 0px', threshold: [0.01, 0.2, 0.5] }
      )
      sections.forEach((section) => observer.observe(section))
    }

    document.querySelectorAll<HTMLElement>('[data-unit-demo]').forEach((demo) => {
      const input = demo.querySelector<HTMLInputElement>('[data-unit-input]')
      const output = demo.querySelector<HTMLElement>('[data-unit-output]')
      const suffix = demo.querySelector<HTMLElement>('[data-unit-suffix]')
      const buttons = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-locale]'))
      let locale = 'en'

      const format = () => {
        if (!input || !output || !suffix) return
        const value = Number(input.value.replace(/,/g, '')) || 0
        const formatted = new Intl.NumberFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
          notation: 'compact',
          maximumFractionDigits: 2,
        }).format(value)
        const match = formatted.match(/^([\d.,]+)(.*)$/)
        output.textContent = match?.[1] ?? formatted
        suffix.textContent = match?.[2] ?? ''
      }

      input?.addEventListener('input', format)
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          locale = button.dataset.locale || 'en'
          buttons.forEach((item) => item.classList.toggle('is-active', item === button))
          format()
        })
      })
      format()
    })
  </script>
</DraftLayout>
