---
import CodeTabs from '../components/CodeTabs.astro'
import PaperCrane from '../components/Crane'
import PlatformLogo from '../components/PlatformLogo.astro'
import ProjectCard from '../components/ProjectCard.astro'
import ProjectReference from '../components/ProjectReference.astro'
import ThemeBookmark from '../components/ThemeBookmark'
import { colophon, isWingsProject, now, platforms, principles, profile, projects, writing } from '../data/site'
import Layout from '../layouts/Layout.astro'
import '../styles/paper.css'

const nav = [
  { label: '首页', href: '#home', key: 'home' },
  { label: '作品', href: '#work', key: 'work' },
  { label: '关于', href: '#about', key: 'about' },
  { label: '写作', href: '#writing', key: 'writing' },
]
---

<Layout title="FLYCRAN · 前端架构工程师" bodyClass="paper-body">
  <div class="p-root">
    <div class="p-grain" aria-hidden="true"></div>

    <header class="p-topbar">
      <a class="p-logo" href="#home" aria-label="FLYCRAN 首页">
        <span class="p-logo-mark" aria-hidden="true">F</span>
        <span class="p-logo-text">FLYCRAN <em>/ WINGS</em></span>
      </a>
      <div class="p-topbar-right">
        <span class="p-topbar-note">示例简历 · 待替换</span>
        <a class="p-topbar-cta" href="#contact">简历 / 联系 <span aria-hidden="true">↓</span></a>
      </div>
    </header>

    <aside class="p-rail" aria-label="书签导航">
      <nav class="p-rail-tabs">
        {
          nav.map((item, index) => (
            <a
              class:list={['p-tab', { 'is-active': index === 0 }]}
              href={item.href}
              data-nav-link={item.key}
              aria-current={index === 0 ? 'page' : undefined}
            >
              <span class="p-tab-label">{item.label}</span>
              <span class="p-tab-arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </nav>
      <ThemeBookmark client:load />
    </aside>

    <nav class="p-mobilebar" aria-label="移动端导航">
      {
        nav.map((item, index) => (
          <a
            class:list={['p-mobile-tab', { 'is-active': index === 0 }]}
            href={item.href}
            data-nav-link={item.key}
            aria-current={index === 0 ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <button class="p-mobile-theme" type="button" data-theme-toggle aria-label="切换深色模式">
        ◐
      </button>
    </nav>

    <main id="main" class="p-main">
      <section class="p-hero" id="home">
        <svg
          class="p-sketch"
          viewBox="0 0 1440 900"
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
        >
          <defs>
            <filter id="pencil-rough" x="-5%" y="-5%" width="110%" height="110%">
              <feTurbulence
                type="fractalNoise"
                baseFrequency="0.012"
                numOctaves="2"
                seed="11"
                result="noise"
              />
              <feDisplacementMap
                in="SourceGraphic"
                in2="noise"
                scale="1.8"
                xChannelSelector="R"
                yChannelSelector="G"
              />
            </filter>
          </defs>

          <g class="p-sketch-lines" filter="url(#pencil-rough)">
            <path
              class="sk sk-muted"
              d="M 742 430 C 752 258 916 158 1092 174 C 1278 192 1392 318 1362 500 C 1334 668 1176 736 1014 712 C 852 688 744 590 752 438 C 757 360 782 302 820 256"
            />
            <path class="sk sk-orange" d="M 1248 118 L 1362 166 L 1296 232 Z" />
            <path class="sk sk-orange sk-dash" d="M 1248 118 L 1296 232 M 1362 166 L 1296 232" />

            <path class="sk sk-blue" d="M 632 676 C 686 666 728 636 762 600" />
            <path class="sk sk-blue" d="M 750 604 L 762 600 L 758 613" />

            <path class="sk sk-muted" d="M 126 420 L 136 398 M 126 420 L 136 442 M 126 420 L 104 410 M 126 420 L 104 432" />
            <path class="sk sk-muted" d="M 1120 708 L 1140 680 M 1134 714 L 1154 686 M 1148 720 L 1168 692 M 1162 726 L 1182 698" />
            <path class="sk sk-muted" d="M 90 812 L 110 812 M 100 802 L 100 822" />
            <path class="sk sk-muted" d="M 1330 84 L 1348 84 M 1339 75 L 1339 93" />
            <circle class="sk sk-muted" cx="1310" cy="770" r="2.5" />
            <circle class="sk sk-muted" cx="700" cy="190" r="2" />
            <circle class="sk sk-muted" cx="1390" cy="610" r="1.8" />
            <path class="sk sk-muted sk-dash" d="M 60 300 C 90 286 120 292 138 312" />
          </g>

          <g class="p-sketch-labels">
            <text x="1240" y="842">NOTE / 01</text>
          </g>
        </svg>

        <div class="p-hero-copy" data-reveal>
          <div class="p-status">
            <span class="p-status-dot" aria-hidden="true"></span>
            <span>{profile.availability}</span>
            <span class="p-status-sep" aria-hidden="true">·</span>
            <span>{profile.location}</span>
          </div>
          <p class="p-kicker">{profile.kicker}</p>
          <h1>
            <span class="p-h1-line">把重复劳动变成<span class="p-mark">工具</span>，</span>
            <span class="p-h1-line">把复杂系统变成<span class="p-mark p-mark--orange">体验</span>。</span>
          </h1>
          <p class="p-intro">{profile.intro}</p>
          <div class="p-actions">
            <a class="p-btn p-btn--primary" href="#work">看作品 <span aria-hidden="true">↘</span></a>
            <a class="p-btn p-btn--ghost" href="#contact">下载简历 <span aria-hidden="true">↓</span></a>
            <button class="p-copy" type="button" data-copy-email={profile.email}>
              复制邮箱
            </button>
          </div>
          <div class="p-hero-links">
            {
              profile.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ))
            }
            <span class="p-hero-links-note">示例数据，等待替换</span>
          </div>
        </div>

        <div class="p-hero-stage" data-reveal>
          <div class="p-bigword" aria-hidden="true">FLY<br />CRAN</div>
          <div class="p-scrap p-scrap--orange" aria-hidden="true"></div>
          <div class="p-scrap p-scrap--blue" aria-hidden="true"></div>
          <div class="p-code-sheet">
            <div class="p-code-sheet-head">
              <span class="p-code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>FLYCRAN / PROFILE</span>
              <span class="p-code-sheet-tag">v2.0</span>
            </div>
            <CodeTabs />
            <div class="p-code-sheet-foot">
              <span>没有数据库，也没有后台</span>
              <span>纯静态 / Astro</span>
            </div>
          </div>
          <PaperCrane client:load className="p-hero-crane" />
          <div class="p-crane-note">
            <span>点一下纸鹤</span>
            <span class="p-crane-note-line" aria-hidden="true"></span>
          </div>
        </div>

        <a class="p-scroll" href="#work" aria-label="继续阅读，翻到作品">
          <span class="p-scroll-text">继续阅读</span>
          <span class="p-scroll-track" aria-hidden="true">
            <svg class="p-scroll-arrow" viewBox="0 0 12 18">
              <path d="M6 2V16M1.5 11.5L6 16l4.5-4.5" />
            </svg>
            <span class="p-scroll-line"></span>
          </span>
        </a>
      </section>

      <section class="p-section" id="work">
        <div class="p-section-head" data-reveal>
          <span class="p-section-index">01</span>
          <div class="p-section-title">
            <p class="p-kicker">SELECTED WORK</p>
            <h2>做过的东西</h2>
          </div>
          <p class="p-section-note">每张卡都带一个可玩的证据，不是截图。</p>
        </div>

        <div class="p-work-grid">
          {projects.map((project) =>
            isWingsProject(project) ? (
              <ProjectReference project={project} />
            ) : (
              <ProjectCard project={project} />
            )
          )}
        </div>
      </section>

      <div class="p-fold" aria-hidden="true">
        <span>FOLD HERE</span>
      </div>

      <section class="p-section" id="about">
        <div class="p-section-head" data-reveal>
          <span class="p-section-index">02</span>
          <div class="p-section-title">
            <p class="p-kicker">ABOUT / HOW I WORK</p>
            <h2>关于我</h2>
          </div>
          <p class="p-section-note">不是简历摘要；是为什么做工具、怎么合作。</p>
        </div>

        <div class="p-about-grid">
          <figure class="p-portrait" data-reveal>
            <div class="p-portrait-inner">
              <span class="p-portrait-char">飞</span>
              <span class="p-portrait-seal">FLYCRAN<br />飞鹤</span>
              <span class="p-portrait-caption">示例头像<br />待替换</span>
            </div>
            <figcaption>照片 / 纸鹤插画 · 待替换</figcaption>
          </figure>

          <div class="p-about-copy" data-reveal>
            <p class="p-lead">
              我从写页面开始，慢慢对“为什么每次都要手动做这件事”更感兴趣。
            </p>
            <p>
              现在我做前端架构和开发者工具：让类型、构建、编辑器替人记住规则，让团队把时间花在产品上。我喜欢把反复出现的问题，变成一次性的解决方案；也喜欢把复杂的东西画清楚、讲明白。
            </p>
            <p>
              我想找的团队：重视工程质量，也愿意为体验多走一步；有真实的用户和反馈；不把“能跑”当成终点。
            </p>

            <div class="p-principles">
              <p class="p-kicker">PRINCIPLES / 04</p>
              {
                principles.map((item, index) => (
                  <div class="p-principle">
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <p>{item}</p>
                  </div>
                ))
              }
            </div>

            <div class="p-now">
              <p class="p-kicker">NOW / 现在</p>
              {
                now.map((item) => (
                  <div class="p-now-row">
                    <span>{item.label}</span>
                    <p>{item.value}</p>
                  </div>
                ))
              }
            </div>

            <div class="p-ask">
              <span>Ask me about</span>
              <div>
                <em>TypeScript</em><em>构建工具</em><em>设计系统</em><em>独立开发</em>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="p-section" id="writing">
        <div class="p-section-head" data-reveal>
          <span class="p-section-index">03</span>
          <div class="p-section-title">
            <p class="p-kicker">WRITING / SELECTED POSTS</p>
            <h2>技术写作</h2>
          </div>
          <p class="p-section-note">精选文章索引 · 外链至原文。</p>
        </div>

        <p class="p-writing-intro" data-reveal>
          长文主要发布在掘金，本站仅保留平台入口与精选索引。
        </p>

        <div class="p-platforms" data-reveal>
          {
            platforms.map((platform) => (
              <a
                class="p-platform"
                href={platform.href}
                target="_blank"
                rel="noopener noreferrer"
                style={`--accent: var(--p-${platform.accent}); --accent-bright: var(--p-${platform.accent}-bright);`}
              >
                <span class="p-platform-mark" aria-hidden="true"><PlatformLogo id={platform.id} /></span>
                <span class="p-platform-copy">
                  <strong>{platform.name}</strong>
                  <span>{platform.handle}</span>
                  <small>{platform.description}</small>
                </span>
                <span class="p-platform-arrow" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>

        <div class="p-writing-list" data-reveal>
          {
            writing.map((item, index) => (
              <a class="p-writing-row" href="https://juejin.cn/user/1737682330585838" target="_blank" rel="noopener noreferrer">
                <span class="p-writing-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="p-writing-title">{item.title}</span>
                <span class="p-writing-meta">{item.platform} · {item.date}</span>
                <span class="p-writing-tag">{item.tag}</span>
                <span class="p-writing-arrow" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
        <p class="p-writing-foot">示例链接 · 最后同步 2026.10 · 之后可接 GitHub Action</p>
      </section>

      <section class="p-contact" id="contact">
        <p class="p-kicker" data-reveal>04 / CONTACT</p>
        <h2 data-reveal>
          如果你在找一个能把工具做好、<br />
          也愿意把界面做有趣的人，聊聊。
        </h2>
        <a class="p-email" href={`mailto:${profile.email}`} data-reveal>{profile.email}</a>
        <div class="p-contact-actions" data-reveal>
          <button class="p-btn p-btn--primary" type="button" data-copy-email={profile.email}>
            复制邮箱
          </button>
          <a class="p-btn p-btn--ghost" href="https://github.com/flycran" target="_blank" rel="noopener noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a class="p-btn p-btn--ghost" href="https://juejin.cn/user/1737682330585838" target="_blank" rel="noopener noreferrer">
            掘金 <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="p-contact-note" data-reveal>示例邮箱 · 之后换成你的真实邮箱 / 微信二维码</p>
      </section>
    </main>

    <footer class="p-footer">
      <div class="p-footer-top">
        <p>Wings / 飞鹤 / 自由</p>
        <p>{colophon.note}</p>
      </div>
      <div class="p-footer-wordmark" aria-label="FLYCRAN">
        <span class="p-footer-fly">FLY</span><span class="p-footer-cran">CRAN</span>
      </div>
      <div class="p-footer-grid">
        <p>Built with {colophon.builtWith}<br />No database. No tracking.</p>
        <p>© {colophon.year} FLYCRAN<br />All mistakes are mine.</p>
        <p><a href="#home">回到顶部 ↑</a><br /><a href="#work">看作品</a></p>
      </div>
      <span class="p-footer-seal" aria-hidden="true">飞鹤<br />FLYCRAN</span>
    </footer>
  </div>

  <script>
    // Mobile/desktop bookmark nav active state
    const navLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-link]'))
    const sections = ['home', 'work', 'about', 'writing']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el))

    const setActive = (key: string) => {
      navLinks.forEach((link) => {
        const active = link.dataset.navLink === key
        link.classList.toggle('is-active', active)
        if (active) link.setAttribute('aria-current', 'page')
        else link.removeAttribute('aria-current')
      })
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
          if (visible?.target.id) setActive(visible.target.id)
        },
        { rootMargin: '-24% 0px -58% 0px', threshold: [0.01, 0.2, 0.5] }
      )
      sections.forEach((section) => observer.observe(section))
    }

    // WebView paper tilt
    const codeSheet = document.querySelector<HTMLElement>('.p-code-sheet')
    const canTilt = window.matchMedia('(hover: hover) and (pointer: fine)').matches
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (codeSheet && canTilt && !reduceMotion) {
      const state = { x: 0, y: 0, lift: 0 }
      const target = { x: 0, y: 0, lift: 0 }
      let frame = 0

      const render = () => {
        codeSheet.style.transform = `perspective(1200px) translateY(${-state.lift}px) rotate(-1.4deg) rotateX(${state.x}deg) rotateY(${state.y}deg) scale(${1 + state.lift * 0.0009})`
      }

      const tick = () => {
        state.x += (target.x - state.x) * 0.14
        state.y += (target.y - state.y) * 0.14
        state.lift += (target.lift - state.lift) * 0.14
        render()

        const settled =
          Math.abs(target.x - state.x) < 0.01 &&
          Math.abs(target.y - state.y) < 0.01 &&
          Math.abs(target.lift - state.lift) < 0.01

        if (settled) {
          state.x = target.x
          state.y = target.y
          state.lift = target.lift
          frame = 0
          if (target.x === 0 && target.y === 0 && target.lift === 0) {
            codeSheet.style.removeProperty('transform')
          }
          return
        }

        frame = requestAnimationFrame(tick)
      }

      const start = () => {
        if (!frame) frame = requestAnimationFrame(tick)
      }

      codeSheet.addEventListener('pointerenter', () => {
        codeSheet.classList.add('is-tilting')
        target.lift = 8
        start()
      })

      codeSheet.addEventListener('pointermove', (event) => {
        const rect = codeSheet.getBoundingClientRect()
        target.x = (0.5 - (event.clientY - rect.top) / rect.height) * 10.5
        target.y = ((event.clientX - rect.left) / rect.width - 0.5) * 10.5
        target.lift = 8
        start()
      })

      codeSheet.addEventListener('pointerleave', () => {
        codeSheet.classList.remove('is-tilting')
        target.x = 0
        target.y = 0
        target.lift = 0
        start()
      })
    }
  </script>
</Layout>
